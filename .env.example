# Copy to .env and change the values:  cp .env.example .env
# .env is git-ignored - never commit real passwords.
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=bookshelf
MYSQL_USER=app
MYSQL_PASSWORD=change-me-app

# Host port for the app. macOS uses 5000 for AirPlay Receiver, so default to 5050.
APP_PORT=5050
